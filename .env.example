# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://bkaigyrrzsqbfscyznzw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side service role key (get from Supabase Dashboard → Project Settings → API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for OAuth redirect + email confirmation links)
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Upstash Redis (Required — caching, pub/sub, rate limiting, presence)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
